# Copy file này thành .env rồi điền giá trị thật:
#   cp .env.example .env
# (.gitignore đã chặn .env — không commit key thật.)
#
# Sau khi export, dùng thủ công (ví dụ PowerShell: $env:GOOGLE_API_KEY = ...),
# repo này không tự động load .env — không file .py nào gọi python-dotenv.

# Bắt buộc cho: semantic_cache.py, eval_ragas.py, eval_deepeval.py
GOOGLE_API_KEY=

# Không có biến môi trường nào khác được code đọc. SharedRedisCache trong
# cache.py nhận địa chỉ Redis qua tham số constructor (redis_url), không qua
# biến môi trường — mặc định trong các ví dụ là "redis://localhost:6379",
# khớp docker-compose.yml.
